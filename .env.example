# PolicyNote API key, the full key_prod_... value (never commit the real value).
# The proxy trades it for 30-minute access tokens at /v1/auth/token.
# POLICY_NOTE_BEARER_TOKEN is still read if this is blank.
POLICY_NOTE_API_KEY=

# Optional: the key_id half of the API key (key_id.secret), sent as authentication_token on
# PolicyNote app-data calls (projects / tags). Blank = taken from POLICY_NOTE_API_KEY.
POLICY_NOTE_KEY_ID=

# Optional API host (default: https://data.policynote.com)
POLICY_NOTE_BASE_URL=https://data.policynote.com

# Shared secret required on x-ga-policy-key from Sitefinity + site clients
GA_POLICY_PROXY_KEY=

# Congress.gov API key (api.congress.gov). Used for federal bill numbers only.
# Set this in Netlify environment variables. Never commit the real value.
CONGRESS_API_KEY=

# Cache TTL in hours (default 168 = 7 days)
POLICY_NOTE_CACHE_TTL_HOURS=168
